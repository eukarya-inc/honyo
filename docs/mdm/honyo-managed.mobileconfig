<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Honyo managed settings — macOS configuration profile.

    Upload this file as a custom profile in your MDM (Jamf Pro, Kandji, Mosyle,
    Intune, …). It writes the preference domain com.rot1024.honyo, which Honyo
    reads from /Library/Managed Preferences and enforces for every profile on
    the machine. Replace the example values below; remove any provider you do
    not manage. Generate fresh UUIDs (uuidgen) before deploying.
  -->
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>com.apple.ManagedClient.preferences</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadIdentifier</key>
      <string>com.example.honyo.managed.preferences</string>
      <key>PayloadUUID</key>
      <string>5F3E1C2A-6B7D-4E8F-9A0B-1C2D3E4F5A6B</string>
      <key>PayloadDisplayName</key>
      <string>Honyo provider settings</string>
      <key>PayloadContent</key>
      <dict>
        <key>com.rot1024.honyo</key>
        <dict>
          <key>Forced</key>
          <array>
            <dict>
              <key>mcx_preference_settings</key>
              <dict>
                <key>providers</key>
                <dict>
                  <key>anthropic</key>
                  <dict>
                    <key>apiKey</key>
                    <string>sk-ant-REPLACE-ME</string>
                    <key>baseUrl</key>
                    <string>https://llm-gateway.example.com/anthropic</string>
                  </dict>
                  <key>openai</key>
                  <dict>
                    <key>baseUrl</key>
                    <string>https://llm-gateway.example.com/openai</string>
                  </dict>
                  <key>google</key>
                  <dict>
                    <key>baseUrl</key>
                    <string>https://llm-gateway.example.com/google</string>
                  </dict>
                  <key>xai</key>
                  <dict>
                    <key>baseUrl</key>
                    <string>https://llm-gateway.example.com/xai</string>
                  </dict>
                </dict>
              </dict>
            </dict>
          </array>
        </dict>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
  <string>Honyo managed settings</string>
  <key>PayloadIdentifier</key>
  <string>com.example.honyo.managed</string>
  <key>PayloadOrganization</key>
  <string>Example Inc.</string>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
